{
  "name": "slack-matrix-bridge",
  "version": "0.1.0",
  "description": "Slack to Matrix messaging bridge on Cloudflare Workers",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run wrangler dev",
    "deploy": "bun run wrangler deploy",
    "tail": "bun run wrangler tail",
    "typecheck": "bun run tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "slack",
    "matrix",
    "bridge",
    "cloudflare",
    "workers"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@cloudflare/workers-types": "^4.20241227.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8",
    "wrangler": "^4.90.1"
  },
  "overrides": {
    "vite": "7.3.3",
    "postcss": "8.5.14",
    "rollup": "4.60.3",
    "picomatch": "4.0.4",
    "undici": "7.25.0"
  }
}
